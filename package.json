{
	"name": "directus-extension-manage-system-fields",
	"description": "Configure visibility, order, and width of system_fields on Files and Users item forms by role and policy",
	"icon": "tune",
	"version": "1.0.0",
	"license": "MIT",
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-bundle",
		"system-fields",
		"fields",
		"files",
		"users",
		"field-order",
		"order",
		"roles",
		"policies"
	],
	"type": "module",
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/domdus/directus-extension-manage-system-fields.git"
	},
	"bugs": {
		"url": "https://github.com/domdus/directus-extension-manage-system-fields/issues"
	},
	"homepage": "https://github.com/domdus/directus-extension-manage-system-fields#readme",
	"directus:extension": {
		"type": "bundle",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"entries": [
			{
				"type": "module",
				"name": "system-fields",
				"source": "src/module/index.ts"
			},
			{
				"type": "hook",
				"name": "system-fields-hook",
				"source": "src/hook/index.ts"
			}
		],
		"host": ">=9.26.0 <13.0.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"add": "directus-extension add"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "^17.0.0",
		"@directus/types": "^13.0.0",
		"typescript": "^5.0.0",
		"vue": "^3.3.7",
		"vuedraggable": "^4.1.0"
	}
}
